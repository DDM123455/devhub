---
import '../styles/global.css';
import Header from '@/components/layout/Header.astro';
import PrivacyBanner from '@/components/layout/PrivacyBanner.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import Footer from '@/components/layout/Footer.astro';
import { rtlLocales, type Locale } from '@/i18n/config';
import { getFixedT } from '@/i18n/i18next';

interface Props {
	title: string;
	lang: Locale;
	description?: string;
	showSearch?: boolean;
}

const { title, lang, description, showSearch = false } = Astro.props;
const dir = rtlLocales.has(lang) ? 'rtl' : 'ltr';
const t = getFixedT(lang);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Open Graph's og:locale wants a language_TERRITORY tag, not the bare 2-letter code this
// site otherwise uses everywhere for routing/i18n — mapped once here rather than per-page.
const OG_LOCALE: Record<Locale, string> = {
	en: 'en_US',
	vi: 'vi_VN',
	es: 'es_ES',
	pt: 'pt_PT',
	fr: 'fr_FR',
	de: 'de_DE',
	ja: 'ja_JP',
	ko: 'ko_KR',
	zh: 'zh_CN',
	'zh-tw': 'zh_TW',
	it: 'it_IT',
	ru: 'ru_RU',
	nl: 'nl_NL',
	pl: 'pl_PL',
	tr: 'tr_TR',
	id: 'id_ID',
	ar: 'ar_AR',
	hi: 'hi_IN',
	th: 'th_TH',
	sv: 'sv_SE',
};
---

<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var theme = stored
						? stored
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
					if (theme === 'dark') {
						document.documentElement.classList.add('dark');
					}
				} catch (e) {}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Web Tool Hub" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={OG_LOCALE[lang]} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground"
		>
			{t('nav.skipToContent')}
		</a>
		<PrivacyBanner lang={lang} />
		<Header lang={lang} showSearch={showSearch} />
		<div class="flex flex-1">
			<Sidebar lang={lang} />
			<main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
				<slot />
			</main>
		</div>
		<Footer lang={lang} />
		<script>
			const sidebar = document.getElementById('sidebar');
			const sidebarBackdrop = document.getElementById('sidebar-backdrop');
			const sidebarToggle = document.getElementById('sidebar-toggle');
			let isSidebarOpen = false;

			function getFocusable(container: HTMLElement): HTMLElement[] {
				return Array.from(
					container.querySelectorAll<HTMLElement>(
						'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])',
					),
				).filter((el) => el.offsetParent !== null);
			}

			function openSidebar() {
				sidebar?.classList.remove('-translate-x-full');
				sidebarBackdrop?.classList.remove('hidden');
				document.body.classList.add('overflow-hidden');
				isSidebarOpen = true;
				if (sidebar) getFocusable(sidebar)[0]?.focus();
			}

			function closeSidebar() {
				sidebar?.classList.add('-translate-x-full');
				sidebarBackdrop?.classList.add('hidden');
				document.body.classList.remove('overflow-hidden');
				if (isSidebarOpen) sidebarToggle?.focus();
				isSidebarOpen = false;
			}

			sidebarToggle?.addEventListener('click', () => {
				const isOpen = sidebar && !sidebar.classList.contains('-translate-x-full');
				if (isOpen) closeSidebar();
				else openSidebar();
			});
			sidebarBackdrop?.addEventListener('click', closeSidebar);
			sidebar?.addEventListener('click', (event) => {
				if ((event.target as HTMLElement)?.closest('a')) closeSidebar();
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					closeSidebar();
					return;
				}
				// Trap Tab focus inside the mobile off-canvas sidebar while it's open, so
				// keyboard users can't tab into content hidden behind the backdrop.
				if (event.key !== 'Tab' || !isSidebarOpen || !sidebar) return;
				const focusable = getFocusable(sidebar);
				if (focusable.length === 0) return;
				const first = focusable[0];
				const last = focusable[focusable.length - 1];
				if (event.shiftKey && document.activeElement === first) {
					event.preventDefault();
					last.focus();
				} else if (!event.shiftKey && document.activeElement === last) {
					event.preventDefault();
					first.focus();
				}
			});

			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				try {
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				} catch (e) {}
			});
		</script>
	</body>
</html>
