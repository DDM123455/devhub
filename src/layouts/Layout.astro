---
import '../styles/global.css';
import Header from '@/components/layout/Header.astro';
import PrivacyBanner from '@/components/layout/PrivacyBanner.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import Footer from '@/components/layout/Footer.astro';
import { rtlLocales, type Locale } from '@/i18n/config';
import { getFixedT } from '@/i18n/i18next';
import { getAlternates, toHreflang } from '@/lib/locale-paths';

interface Props {
	title: string;
	lang: Locale;
	description?: string;
	// Path under /public used for og:image/twitter:image, e.g. "/og/pdf.png".
	// Defaults to the site-wide banner so every page gets a real social-share
	// preview image even if the specific page never opts into a category one.
	ogImage?: string;
	// Ép trang là noindex (vd 404).
	noindex?: boolean;
}

const { title, lang, description, ogImage = '/og/default.png', noindex = false } = Astro.props;
const dir = rtlLocales.has(lang) ? 'rtl' : 'ltr';
const t = getFixedT(lang);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
// hreflang: tự suy ra từ pathname (home / privacy / tool theo slug bản địa); 404 và trang lạ thì không có.
const alternates = getAlternates(Astro.url.pathname, lang);
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// Open Graph's og:locale wants a language_TERRITORY tag, not the bare 2-letter code this
// site otherwise uses everywhere for routing/i18n — mapped once here rather than per-page.
const OG_LOCALE: Record<Locale, string> = {
	en: 'en_US',
	vi: 'vi_VN',
	es: 'es_ES',
	pt: 'pt_PT',
	fr: 'fr_FR',
	de: 'de_DE',
	ja: 'ja_JP',
	ko: 'ko_KR',
	zh: 'zh_CN',
	'zh-tw': 'zh_TW',
	it: 'it_IT',
	ru: 'ru_RU',
	nl: 'nl_NL',
	pl: 'pl_PL',
	tr: 'tr_TR',
	id: 'id_ID',
	ar: 'ar_AR',
	hi: 'hi_IN',
	th: 'th_TH',
	sv: 'sv_SE',
};
---

<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var theme = stored
						? stored
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
					if (theme === 'dark') {
						document.documentElement.classList.add('dark');
					}
				} catch (e) {}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		{alternates.map((alt) => (
			<link rel="alternate" hreflang={toHreflang(alt.locale)} href={new URL(alt.path, Astro.site).toString()} />
		))}
		{alternates.length > 0 && (
			<link rel="alternate" hreflang="x-default" href={new URL(alternates.find((a) => a.locale === 'en')!.path, Astro.site).toString()} />
		)}
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Web Tool Hub" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={OG_LOCALE[lang]} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={ogImageUrl} />
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground"
		>
			{t('nav.skipToContent')}
		</a>
		<PrivacyBanner lang={lang} />
		<Header lang={lang} />
		<div class="flex flex-1">
			<Sidebar lang={lang} />
			<main id="main-content" tabindex="-1" class="min-w-0 flex-1 focus:outline-none">
				<slot />
			</main>
		</div>
		<Footer lang={lang} />
		<script>
			const sidebar = document.getElementById('sidebar');
			const sidebarBackdrop = document.getElementById('sidebar-backdrop');
			const sidebarToggle = document.getElementById('sidebar-toggle');
			const desktopQuery = window.matchMedia('(min-width: 768px)');
			let isSidebarOpen = false;

			function getFocusable(container: HTMLElement): HTMLElement[] {
				return Array.from(
					container.querySelectorAll<HTMLElement>(
						'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])',
					),
				).filter((el) => el.offsetParent !== null);
			}

			function setOpen(open: boolean) {
				isSidebarOpen = open;
				sidebar?.setAttribute('data-open', String(open));
				sidebarBackdrop?.classList.toggle('hidden', !open);
				document.body.classList.toggle('overflow-hidden', open);
				sidebarToggle?.setAttribute('aria-expanded', String(open));
				// Đóng trên mobile: inert để Tab/AT không vào được (desktop luôn hiển thị nên không inert).
				if (sidebar) sidebar.inert = !open && !desktopQuery.matches;
			}

			function openSidebar() {
				setOpen(true);
				if (sidebar) getFocusable(sidebar)[0]?.focus();
			}

			function closeSidebar(restoreFocus = true) {
				const wasOpen = isSidebarOpen;
				setOpen(false);
				if (wasOpen && restoreFocus) sidebarToggle?.focus();
			}

			setOpen(false);
			desktopQuery.addEventListener('change', () => {
				// Resize lên desktop: bỏ khoá cuộn body, ẩn backdrop, không giật focus.
				closeSidebar(false);
			});

			sidebarToggle?.addEventListener('click', () => {
				if (isSidebarOpen) closeSidebar();
				else openSidebar();
			});
			sidebarBackdrop?.addEventListener('click', () => closeSidebar());
			sidebar?.addEventListener('click', (event) => {
				if ((event.target as HTMLElement)?.closest('a') && isSidebarOpen) closeSidebar();
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					if (isSidebarOpen) closeSidebar();
					return;
				}
				// Trap Tab focus inside the mobile off-canvas sidebar while it's open, so
				// keyboard users can't tab into content hidden behind the backdrop.
				if (event.key !== 'Tab' || !isSidebarOpen || !sidebar) return;
				const focusable = getFocusable(sidebar);
				if (focusable.length === 0) return;
				const first = focusable[0];
				const last = focusable[focusable.length - 1];
				if (event.shiftKey && document.activeElement === first) {
					event.preventDefault();
					last.focus();
				} else if (!event.shiftKey && document.activeElement === last) {
					event.preventDefault();
					first.focus();
				}
			});

			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const isDark = document.documentElement.classList.toggle('dark');
				try {
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				} catch (e) {}
			});
		</script>
	</body>
</html>
