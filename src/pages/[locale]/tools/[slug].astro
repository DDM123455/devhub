---
import Layout from '../../../layouts/Layout.astro';
import ImageCompressPage from '@/components/tools/ImageCompressPage.astro';
import ImageConvertPage from '@/components/tools/ImageConvertPage.astro';
import BackgroundRemoverPage from '@/components/tools/BackgroundRemoverPage.astro';
import PdfMergePage from '@/components/tools/PdfMergePage.astro';
import PdfSplitPage from '@/components/tools/PdfSplitPage.astro';
import TextDiffPage from '@/components/tools/TextDiffPage.astro';
import WordCounterPage from '@/components/tools/WordCounterPage.astro';
import JsonFormatterPage from '@/components/tools/JsonFormatterPage.astro';
import QrCodeGeneratorPage from '@/components/tools/QrCodeGeneratorPage.astro';
import TextCaseConverterPage from '@/components/tools/TextCaseConverterPage.astro';
import JwtDecoderPage from '@/components/tools/JwtDecoderPage.astro';
import Base64ToolPage from '@/components/tools/Base64ToolPage.astro';
import RegexTesterPage from '@/components/tools/RegexTesterPage.astro';
import { locales, type Locale } from '@/i18n/config';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';

export function getStaticPaths() {
	return locales.flatMap((locale) =>
		tools.map((tool) => ({
			params: { locale, slug: tool.slugs[locale] },
			props: { toolId: tool.id },
		})),
	);
}

const { locale } = Astro.params as { locale: Locale };
const { toolId } = Astro.props as { toolId: string };
const t = getFixedT(locale);
const tool = tools.find((item) => item.id === toolId)!;
const name = tool.names[locale];
---

{
	toolId === 'image-compress' ? (
		<ImageCompressPage lang={locale} />
	) : toolId === 'image-convert' ? (
		<ImageConvertPage lang={locale} />
	) : toolId === 'background-remover' ? (
		<BackgroundRemoverPage lang={locale} />
	) : toolId === 'pdf-merge' ? (
		<PdfMergePage lang={locale} />
	) : toolId === 'pdf-split' ? (
		<PdfSplitPage lang={locale} />
	) : toolId === 'text-diff' ? (
		<TextDiffPage lang={locale} />
	) : toolId === 'word-counter' ? (
		<WordCounterPage lang={locale} />
	) : toolId === 'json-formatter' ? (
		<JsonFormatterPage lang={locale} />
	) : toolId === 'qr-generator' ? (
		<QrCodeGeneratorPage lang={locale} />
	) : toolId === 'text-case-converter' ? (
		<TextCaseConverterPage lang={locale} />
	) : toolId === 'jwt-decoder' ? (
		<JwtDecoderPage lang={locale} />
	) : toolId === 'base64-tool' ? (
		<Base64ToolPage lang={locale} />
	) : toolId === 'regex-tester' ? (
		<RegexTesterPage lang={locale} />
	) : (
		<Layout title={`${name} — Web Tool Hub`} description={name} lang={locale}>
			<section class="px-4 py-10">
				<h1 class="text-2xl font-bold text-foreground">{name}</h1>
				<p class="mt-2 text-muted-foreground">{t('home.comingSoon')}</p>
			</section>
		</Layout>
	)
}
