---
import Layout from '../../../layouts/Layout.astro';
import { locales, type Locale } from '@/i18n/config';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';

export function getStaticPaths() {
	return locales.flatMap((locale) =>
		tools.map((tool) => ({
			params: { locale, slug: tool.slugs[locale] },
			props: { toolId: tool.id },
		})),
	);
}

const { locale } = Astro.params as { locale: Locale };
const { toolId } = Astro.props as { toolId: string };
const t = getFixedT(locale);
const tool = tools.find((item) => item.id === toolId)!;
const name = tool.names[locale];
---

<Layout title={`${name} — Web Tool Hub`} description={name} lang={locale}>
	<section class="px-4 py-10">
		<h1 class="text-2xl font-bold text-foreground">{name}</h1>
		<p class="mt-2 text-muted-foreground">{t('home.comingSoon')}</p>
	</section>
</Layout>
