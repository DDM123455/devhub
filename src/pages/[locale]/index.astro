---
import Layout from '../../layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import { locales, type Locale } from '@/i18n/config';
import { getFixedT } from '@/i18n/i18next';
import { categories } from '@/data/categories';
import { tools } from '@/data/tools';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getFixedT(locale);
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={locale}>
	<section class="px-4 py-10">
		<h1 class="text-3xl font-bold text-foreground">{t('home.heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('home.tagline')}</p>
		<div class="mt-4">
			<Button client:load>Shadcn Button OK</Button>
		</div>
	</section>
	<section class="grid gap-4 px-4 pb-10 sm:grid-cols-2">
		{
			categories.map((category) => (
				<div id={`category-${category.slug}`} class="rounded-lg border border-border p-4">
					<h2 class="font-semibold text-foreground">{t(`nav.categories.${category.slug}`)}</h2>
					<ul class="mt-2 flex flex-col gap-1">
						{tools
							.filter((tool) => tool.category === category.slug)
							.map((tool) => (
								<li>
									<a
										href={`/${locale}/tools/${tool.slugs[locale]}/`}
										class="text-sm text-primary hover:underline"
									>
										{tool.names[locale]}
									</a>
								</li>
							))}
					</ul>
				</div>
			))
		}
	</section>
</Layout>
