---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import WeeksFromTodayCard from '@/components/tools/WeeksFromTodayCard';
import { getFixedT } from '@/i18n/i18next';
import { jsonLd } from '@/lib/json-ld';
import { WEEK_TABLE_ROWS, hasWeekPage } from '@/data/weeks-from-today';
import { addWeeks, formatIsoDate, formatShortDate, formatWeekday, localTodayAsUtc } from '@/lib/date-offset';

export function getStaticPaths() {
	return [{ params: { locale: 'en' } }];
}

const t = getFixedT('en', 'cluster-weeks');

const today = localTodayAsUtc();
const buildDateIso = formatIsoDate(today);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const rows = WEEK_TABLE_ROWS.map((n) => {
	const date = addWeeks(today, n);
	return { n, date, short: formatShortDate(date), weekday: formatWeekday(date), days: n * 7, linked: hasWeekPage(n) };
});

const faqItems = [
	{ question: t('hub.faq.q1'), answer: t('hub.faq.a1') },
	{ question: t('hub.faq.q2'), answer: t('hub.faq.a2') },
	{ question: t('hub.faq.q3'), answer: t('hub.faq.a3') },
];

const messages = {
	resultPrefix: t('page.resultPrefix'),
	countedFrom: t('page.countedFrom'),
	statWeekday: t('page.statWeekday'),
	statTotalDays: t('page.statTotalDays'),
	statWorkingDays: t('page.statWorkingDays'),
	statDayOfYear: t('page.statDayOfYear'),
	statDayOfYearValue: t('page.statDayOfYearValue'),
	copyButton: t('page.copyButton'),
	copiedButton: t('page.copiedButton'),
	copyFailed: t('page.copyFailed'),
	calendarButton: t('page.calendarButton'),
	calendarEventTitle: t('page.calendarEventTitle'),
	startDateLabel: t('page.startDateLabel'),
	weeksLabel: t('hub.inputLabel'),
	resetButton: t('page.resetButton'),
};

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('hub.heading'),
	description: t('hub.meta.description'),
	url: canonicalUrl,
	applicationCategory: 'UtilitiesApplication',
	operatingSystem: 'Any',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout title={t('hub.meta.title')} description={t('hub.meta.description')} lang="en" ogImage="/og/default.png">
	<script type="application/ld+json" set:html={jsonLd(schema)} />
	<section class="px-4 py-10">
		<Breadcrumbs
			items={[
				{ label: t('page.breadcrumbHome'), href: '/en/' },
				{ label: t('page.breadcrumbHub'), href: undefined },
			]}
		/>
		<h1 class="mt-3 text-heading-1 text-foreground">{t('hub.heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('hub.tagline')}</p>
		<div class="mt-6">
			<WeeksFromTodayCard client:load weeks={4} buildDateIso={buildDateIso} messages={messages} />
		</div>
	</section>

	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('hub.tableHeading')}</h2>
		<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{t('hub.tableIntro')}</p>
		<div class="mt-4 overflow-x-auto">
			<table class="w-full min-w-xl border-collapse text-sm">
				<thead>
					<tr class="border-b border-border text-left text-muted-foreground">
						<th scope="col" class="py-2 pr-4 font-medium">{t('hub.colWeeks')}</th>
						<th scope="col" class="py-2 pr-4 font-medium">{t('hub.colDate')}</th>
						<th scope="col" class="py-2 pr-4 font-medium">{t('hub.colWeekday')}</th>
						<th scope="col" class="py-2 font-medium">{t('hub.colDays')}</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr class="border-b border-border/60">
								<th scope="row" class="py-1.5 pr-4 font-normal text-foreground">
									{row.linked ? (
										<a href={`/en/weeks-from-today/${row.n}/`} class="text-primary hover:underline">
											{row.n} weeks
										</a>
									) : (
										<span>{row.n} weeks</span>
									)}
								</th>
								<td class="py-1.5 pr-4 text-foreground">
									<time datetime={formatIsoDate(row.date)}>{row.short}</time>
								</td>
								<td class="py-1.5 pr-4 text-muted-foreground">{row.weekday}</td>
								<td class="py-1.5 text-muted-foreground">{row.days}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('hub.article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 text-muted-foreground">
			<p>{t('hub.article.p1')}</p>
			<p>{t('hub.article.p2')}</p>
			<p>{t('hub.article.p3')}</p>
		</div>
	</section>

	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('hub.faq.heading')} items={faqItems} />
	</section>
</Layout>
