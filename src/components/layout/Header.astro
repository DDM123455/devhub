---
import { getFixedT } from '@/i18n/i18next';
import type { Locale } from '@/i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang);
---

<header class="sticky top-0 z-30 flex items-center justify-between gap-4 border-b border-border bg-background px-4 py-3">
	<a href={`/${lang}/`} class="text-lg font-semibold text-foreground">Web Tool Hub</a>
	<div class="flex items-center gap-3">
		<LanguageSwitcher lang={lang} />
		<ThemeToggle lang={lang} />
		<button
			id="sidebar-toggle"
			type="button"
			class="rounded-md border border-border px-2 py-1 text-sm text-foreground md:hidden"
			aria-label={t('nav.toggleMenu')}
			aria-controls="sidebar"
		>
			☰
		</button>
	</div>
</header>
