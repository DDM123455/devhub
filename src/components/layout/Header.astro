---
import { getFixedT } from '@/i18n/i18next';
import type { Locale } from '@/i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang);
---

<header class="sticky top-0 z-30 flex flex-wrap items-center gap-3 border-b border-border bg-background px-4 py-3.5 sm:px-8 md:flex-nowrap md:gap-6">
	<a href={`/${lang}/`} class="order-1 flex shrink-0 items-center gap-2.5">
		<span class="font-mono text-base font-bold tracking-tight text-emerald-700 dark:text-emerald-400">&gt;_</span>
		<span class="hidden text-lg font-bold tracking-tight text-foreground sm:inline">Web Tool Hub</span>
	</a>

	<div class="order-2 ml-auto flex shrink-0 items-center gap-2.5 md:order-3">
		<LanguageSwitcher lang={lang} />
		<ThemeToggle lang={lang} />
		<button
			id="sidebar-toggle"
			type="button"
			class="flex size-8 shrink-0 items-center justify-center rounded-lg border border-border bg-card text-muted-foreground md:hidden"
			aria-label={t('nav.toggleMenu')}
			aria-controls="sidebar"
		>
			☰
		</button>
	</div>
</header>
