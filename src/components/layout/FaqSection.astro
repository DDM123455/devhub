---
import { jsonLd } from '@/lib/json-ld';
interface FaqItem {
	question: string;
	answer: string;
}

interface Props {
	heading: string;
	items: FaqItem[];
}

const { heading, items } = Astro.props;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<section class="mx-auto flex max-w-3xl flex-col gap-3">
	<h2 class="text-heading-2 text-foreground">{heading}</h2>
	<div class="flex flex-col divide-y divide-border rounded-lg border border-border">
		{
			items.map((item) => (
				<details class="group p-4">
					<summary class="cursor-pointer text-sm font-medium text-foreground marker:text-muted-foreground">
						{item.question}
					</summary>
					<div class="faq-collapse grid grid-rows-[0fr] transition-[grid-template-rows] duration-200 ease-out group-open:grid-rows-[1fr]">
						<div class="overflow-hidden">
							<p class="pt-2 text-sm text-muted-foreground">{item.answer}</p>
						</div>
					</div>
				</details>
			))
		}
	</div>
</section>
<script type="application/ld+json" set:html={jsonLd(schema)} />
<style>
	/* Browsers hide every non-`summary` child of a closed `<details>` via a
	   UA-stylesheet `details:not([open]) > :not(summary) { display: none }`
	   rule — that beats the grid-rows collapse trick below (an element with
	   `display: none` was never laid out, so there's nothing to transition
	   FROM/TO, and the open/close just snaps instantly). Forcing `display:
	   grid` here hands all of the show/hide behavior to the grid-rows
	   transition instead, so it can actually animate both directions. */
	.faq-collapse {
		display: grid !important;
	}
</style>
