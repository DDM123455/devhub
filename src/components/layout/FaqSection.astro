---
interface FaqItem {
	question: string;
	answer: string;
}

interface Props {
	heading: string;
	items: FaqItem[];
}

const { heading, items } = Astro.props;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<section class="flex flex-col gap-3">
	<h2 class="text-lg font-semibold text-foreground">{heading}</h2>
	<div class="flex flex-col divide-y divide-border rounded-lg border border-border">
		{
			items.map((item) => (
				<details class="group p-4">
					<summary class="cursor-pointer text-sm font-medium text-foreground marker:text-muted-foreground">
						{item.question}
					</summary>
					<p class="mt-2 text-sm text-muted-foreground">{item.answer}</p>
				</details>
			))
		}
	</div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
