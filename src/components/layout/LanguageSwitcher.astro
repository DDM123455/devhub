---
import { locales, type Locale } from '@/i18n/config';
import { getFixedT } from '@/i18n/i18next';
import { localizePath, toHreflang } from '@/lib/locale-paths';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;

const nativeNames: Record<Locale, string> = {
	en: 'English',
	vi: 'Tiếng Việt',
	es: 'Español',
	pt: 'Português',
	fr: 'Français',
	de: 'Deutsch',
	ja: '日本語',
	ko: '한국어',
	zh: '简体中文',
	'zh-tw': '繁體中文',
	it: 'Italiano',
	ru: 'Русский',
	nl: 'Nederlands',
	pl: 'Polski',
	tr: 'Türkçe',
	id: 'Bahasa Indonesia',
	ar: 'العربية',
	hi: 'हिन्दी',
	th: 'ไทย',
	sv: 'Svenska',
};

const currentPath = Astro.url.pathname;
const t = getFixedT(lang);
---

<details id="lang-switcher" class="relative">
	<summary
		aria-label={t('nav.language')}
		class="flex min-h-8 cursor-pointer list-none items-center gap-1.5 rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs text-muted-foreground [&::-webkit-details-marker]:hidden"
	>
		<span aria-hidden="true">🌐</span>
		<span>{nativeNames[lang]}</span>
	</summary>
	<ul
		class="absolute end-0 top-full z-50 mt-1 max-h-72 w-44 overflow-y-auto rounded-lg border border-border bg-card p-1 shadow-lg"
	>
		{
			locales.map((loc) => (
				<li>
					<a
						href={localizePath(currentPath, lang, loc)}
						hreflang={toHreflang(loc)}
						lang={toHreflang(loc)}
						aria-current={loc === lang ? 'true' : undefined}
						class:list={[
							'block rounded-md px-2.5 py-1.5 text-xs hover:bg-accent hover:text-foreground',
							loc === lang ? 'bg-accent font-semibold text-foreground' : 'text-muted-foreground',
						]}
					>
						{nativeNames[loc]}
					</a>
				</li>
			))
		}
	</ul>
</details>

<script>
	const switcher = document.getElementById('lang-switcher') as HTMLDetailsElement | null;
	document.addEventListener('click', (event) => {
		if (switcher?.open && !switcher.contains(event.target as Node)) switcher.open = false;
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && switcher?.open) {
			switcher.open = false;
			switcher.querySelector('summary')?.focus();
		}
	});
</script>
