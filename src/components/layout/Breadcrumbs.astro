---
import { jsonLd } from '@/lib/json-ld';

interface Crumb {
	label: string;
	/** Bỏ trống ở mục cuối: trang hiện tại không tự link về chính nó. */
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items.map((item, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: item.label,
		...(item.href ? { item: new URL(item.href, Astro.site).toString() } : {}),
	})),
};
---

<nav aria-label="Breadcrumb" class="text-xs text-muted-foreground">
	<ol class="flex flex-wrap items-center gap-1.5">
		{
			items.map((item, index) => (
				<li class="flex items-center gap-1.5">
					{index > 0 && <span aria-hidden="true">/</span>}
					{item.href ? (
						<a href={item.href} class="hover:text-foreground hover:underline">
							{item.label}
						</a>
					) : (
						<span aria-current="page">{item.label}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
<script type="application/ld+json" set:html={jsonLd(schema)} />
