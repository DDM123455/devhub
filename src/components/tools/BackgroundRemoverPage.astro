---
import Layout from '../../layouts/Layout.astro';
import BackgroundRemover from './BackgroundRemover';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-background-remover');

const tool = tools.find((item) => item.id === 'background-remover')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	selectFiles: t('ui.selectFiles'),
	dropHint: t('ui.dropHint'),
	remove: t('ui.remove'),
	removing: t('ui.removing'),
	download: t('ui.download'),
	original: t('ui.original'),
	result: t('ui.result'),
	noFiles: t('ui.noFiles'),
	errorGeneric: t('ui.errorGeneric'),
	modelNotice: t('ui.modelNotice'),
	backgroundLabel: t('ui.backgroundLabel'),
	backgroundTransparent: t('ui.backgroundTransparent'),
	backgroundColor: t('ui.backgroundColor'),
	backgroundImage: t('ui.backgroundImage'),
	backgroundImageSelect: t('ui.backgroundImageSelect'),
	backgroundImageClear: t('ui.backgroundImageClear'),
	edgeSoftnessLabel: t('ui.edgeSoftnessLabel'),
	removeItem: t('ui.removeItem'),
	clearAll: t('ui.clearAll'),
	skippedFiles: t('ui.skippedFiles'),
};

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'MultimediaApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-3xl font-bold text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6 max-w-2xl">
			<BackgroundRemover client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a
							href={`/${lang}/tools/${related.slugs[lang]}/`}
							class="text-sm text-primary hover:underline"
						>
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
