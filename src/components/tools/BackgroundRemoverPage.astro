---
import { jsonLd } from '@/lib/json-ld';
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import BackgroundRemover from './BackgroundRemover';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-background-remover');

const tool = tools.find((item) => item.id === 'background-remover')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	selectFiles: t('ui.selectFiles'),
	dropHint: t('ui.dropHint'),
	remove: t('ui.remove'),
	removing: t('ui.removing'),
	loadingModel: t('ui.loadingModel'),
	download: t('ui.download'),
	original: t('ui.original'),
	result: t('ui.result'),
	noFiles: t('ui.noFiles'),
	errorGeneric: t('ui.errorGeneric'),
	modelNotice: t('ui.modelNotice'),
	backgroundLabel: t('ui.backgroundLabel'),
	backgroundTransparent: t('ui.backgroundTransparent'),
	backgroundColor: t('ui.backgroundColor'),
	backgroundImage: t('ui.backgroundImage'),
	backgroundImageSelect: t('ui.backgroundImageSelect'),
	backgroundImageClear: t('ui.backgroundImageClear'),
	edgeSoftnessLabel: t('ui.edgeSoftnessLabel'),
	removeItem: t('ui.removeItem'),
	retryItem: t('ui.retryItem'),
	clearAll: t('ui.clearAll'),
	skippedFiles: t('ui.skippedFiles'),
	overallProgress: t('ui.overallProgress'),
	downloadAll: t('ui.downloadAll'),
	trimTransparentEdgesLabel: t('ui.trimTransparentEdgesLabel'),
	resizeToggleLabel: t('ui.resizeToggleLabel'),
	maxDimensionLabel: t('ui.maxDimensionLabel'),
	photoSizeLabel: t('ui.photoSizeLabel'),
	photoSizeNone: t('ui.photoSizeNone'),
	photoSizePreset3x4: t('ui.photoSizePreset3x4'),
	photoSizePreset4x6: t('ui.photoSizePreset4x6'),
	photoSizePreset2x3: t('ui.photoSizePreset2x3'),
	photoSizePreset35x45: t('ui.photoSizePreset35x45'),
	photoSizePreset2x2in: t('ui.photoSizePreset2x2in'),
	dpiLabel: t('ui.dpiLabel'),
	verticalPositionLabel: t('ui.verticalPositionLabel'),
	outputSizeHint: t('ui.outputSizeHint'),
	photoSizeGroup: t('ui.photoSizeGroup'),
	marketplaceGroup: t('ui.marketplaceGroup'),
	marketplaceAmazon: t('ui.marketplaceAmazon'),
	marketplaceShopee: t('ui.marketplaceShopee'),
	marketplaceEtsy: t('ui.marketplaceEtsy'),
	marketplacePaddingLabel: t('ui.marketplacePaddingLabel'),
	marketplaceHint: t('ui.marketplaceHint'),
	editMask: t('ui.editMask'),
	resetEdits: t('ui.resetEdits'),
	editedBadge: t('ui.editedBadge'),
	editorTitle: t('ui.editorTitle'),
	brushRestore: t('ui.brushRestore'),
	brushErase: t('ui.brushErase'),
	brushSize: t('ui.brushSize'),
	zoom: t('ui.zoom'),
	undo: t('ui.undo'),
	redo: t('ui.redo'),
	apply: t('ui.apply'),
	cancel: t('ui.cancel'),
	editorHint: t('ui.editorHint'),
	editorLoading: t('ui.editorLoading'),
	editorError: t('ui.editorError'),
	backgroundGradient: t('ui.backgroundGradient'),
	backgroundBlur: t('ui.backgroundBlur'),
	gradientFromLabel: t('ui.gradientFromLabel'),
	gradientToLabel: t('ui.gradientToLabel'),
	gradientDirectionLabel: t('ui.gradientDirectionLabel'),
	directionVertical: t('ui.directionVertical'),
	directionHorizontal: t('ui.directionHorizontal'),
	directionDiagonal: t('ui.directionDiagonal'),
	blurAmountLabel: t('ui.blurAmountLabel'),
	shadowToggle: t('ui.shadowToggle'),
	shadowSizeLabel: t('ui.shadowSizeLabel'),
	shadowOpacityLabel: t('ui.shadowOpacityLabel'),
	formatLabel: t('ui.formatLabel'),
	qualityLabel: t('ui.qualityLabel'),
	jpgFlattenNote: t('ui.jpgFlattenNote'),
};

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
	{ question: t('faq.q4'), answer: t('faq.a4') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'MultimediaApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang} ogImage={`/og/${tool.category}.png`}>
	<script type="application/ld+json" set:html={jsonLd(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-heading-1 text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6">
			<BackgroundRemover client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 mx-auto text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a
							href={`/${lang}/tools/${related.slugs[lang]}/`}
							class="text-sm text-primary hover:underline"
						>
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
