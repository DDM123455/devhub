---
import { jsonLd } from '@/lib/json-ld';
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import QrCodeGenerator from './QrCodeGenerator';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-qr-generator');

const tool = tools.find((item) => item.id === 'qr-generator')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	contentTypeLabel: t('ui.contentTypeLabel'),
	typeUrl: t('ui.typeUrl'),
	typeText: t('ui.typeText'),
	typeWifi: t('ui.typeWifi'),
	typeVcard: t('ui.typeVcard'),
	typeEmail: t('ui.typeEmail'),
	typeSms: t('ui.typeSms'),
	urlLabel: t('ui.urlLabel'),
	urlPlaceholder: t('ui.urlPlaceholder'),
	textLabel: t('ui.textLabel'),
	textPlaceholder: t('ui.textPlaceholder'),
	wifiSsidLabel: t('ui.wifiSsidLabel'),
	wifiPasswordLabel: t('ui.wifiPasswordLabel'),
	wifiEncryptionLabel: t('ui.wifiEncryptionLabel'),
	wifiEncryptionWpa: t('ui.wifiEncryptionWpa'),
	wifiEncryptionWep: t('ui.wifiEncryptionWep'),
	wifiEncryptionNone: t('ui.wifiEncryptionNone'),
	wifiHiddenLabel: t('ui.wifiHiddenLabel'),
	vcardFirstNameLabel: t('ui.vcardFirstNameLabel'),
	vcardLastNameLabel: t('ui.vcardLastNameLabel'),
	vcardPhoneLabel: t('ui.vcardPhoneLabel'),
	vcardEmailLabel: t('ui.vcardEmailLabel'),
	vcardOrgLabel: t('ui.vcardOrgLabel'),
	vcardUrlLabel: t('ui.vcardUrlLabel'),
	emailToLabel: t('ui.emailToLabel'),
	emailSubjectLabel: t('ui.emailSubjectLabel'),
	emailBodyLabel: t('ui.emailBodyLabel'),
	smsPhoneLabel: t('ui.smsPhoneLabel'),
	smsMessageLabel: t('ui.smsMessageLabel'),
	fgColorLabel: t('ui.fgColorLabel'),
	bgColorLabel: t('ui.bgColorLabel'),
	sizeLabel: t('ui.sizeLabel'),
	levelLabel: t('ui.levelLabel'),
	levelL: t('ui.levelL'),
	levelM: t('ui.levelM'),
	levelQ: t('ui.levelQ'),
	levelH: t('ui.levelH'),
	logoLabel: t('ui.logoLabel'),
	removeLogo: t('ui.removeLogo'),
	pngResolutionLabel: t('ui.pngResolutionLabel'),
	downloadPng: t('ui.downloadPng'),
	downloadSvg: t('ui.downloadSvg'),
	errorTooLong: t('ui.errorTooLong'),
	dotStyleLabel: t('ui.dotStyleLabel'),
	dotStyleSquare: t('ui.dotStyleSquare'),
	dotStyleDots: t('ui.dotStyleDots'),
	dotStyleRounded: t('ui.dotStyleRounded'),
	dotStyleClassy: t('ui.dotStyleClassy'),
	dotStyleClassyRounded: t('ui.dotStyleClassyRounded'),
	dotStyleExtraRounded: t('ui.dotStyleExtraRounded'),
	gradientToggleLabel: t('ui.gradientToggleLabel'),
	gradientTypeLabel: t('ui.gradientTypeLabel'),
	gradientTypeLinear: t('ui.gradientTypeLinear'),
	gradientTypeRadial: t('ui.gradientTypeRadial'),
	gradientStartColorLabel: t('ui.gradientStartColorLabel'),
	gradientEndColorLabel: t('ui.gradientEndColorLabel'),
	batchModeToggle: t('ui.batchModeToggle'),
	batchInputLabel: t('ui.batchInputLabel'),
	batchInputPlaceholder: t('ui.batchInputPlaceholder'),
	batchLineCount: t('ui.batchLineCount'),
	batchGenerateButton: t('ui.batchGenerateButton'),
	batchGenerating: t('ui.batchGenerating'),
	processingQueue: t('ui.processingQueue'),
	batchPreviewNotice: t('ui.batchPreviewNotice'),
	frameToggleLabel: t('ui.frameToggleLabel'),
	frameTextLabel: t('ui.frameTextLabel'),
	frameTextPlaceholder: t('ui.frameTextPlaceholder'),
	frameNotice: t('ui.frameNotice'),
	emptyState: t('ui.emptyState'),
	downloadDisabledEmpty: t('ui.downloadDisabledEmpty'),
	urlAutoHttps: t('ui.urlAutoHttps'),
	contrastInverted: t('ui.contrastInverted'),
	contrastLow: t('ui.contrastLow'),
	logoRaisedLevel: t('ui.logoRaisedLevel'),
	logoRestoredLevel: t('ui.logoRestoredLevel'),
	logoLoadError: t('ui.logoLoadError'),
	logoSelected: t('ui.logoSelected'),
	logoPreviewAlt: t('ui.logoPreviewAlt'),
	errorRender: t('ui.errorRender'),
	errorCanvasSmall: t('ui.errorCanvasSmall'),
	downloadError: t('ui.downloadError'),
	batchSummary: t('ui.batchSummary'),
	batchFailedHeading: t('ui.batchFailedHeading'),
	batchFailedLine: t('ui.batchFailedLine'),
	batchNoneSucceeded: t('ui.batchNoneSucceeded'),
	batchTruncated: t('ui.batchTruncated'),
	batchCancel: t('ui.batchCancel'),
	batchCancelled: t('ui.batchCancelled'),
	qrAriaLabel: t('ui.qrAriaLabel'),
	typePhone: t('ui.typePhone'),
	typeMecard: t('ui.typeMecard'),
	typeGeo: t('ui.typeGeo'),
	typeEvent: t('ui.typeEvent'),
	typeBitcoin: t('ui.typeBitcoin'),
	typeWhatsapp: t('ui.typeWhatsapp'),
	phoneLabel: t('ui.phoneLabel'),
	mecardAddressLabel: t('ui.mecardAddressLabel'),
	mecardNoteLabel: t('ui.mecardNoteLabel'),
	geoLatLabel: t('ui.geoLatLabel'),
	geoLngLabel: t('ui.geoLngLabel'),
	geoInvalid: t('ui.geoInvalid'),
	eventTitleLabel: t('ui.eventTitleLabel'),
	eventStartLabel: t('ui.eventStartLabel'),
	eventEndLabel: t('ui.eventEndLabel'),
	eventAllDayLabel: t('ui.eventAllDayLabel'),
	eventLocationLabel: t('ui.eventLocationLabel'),
	eventDescriptionLabel: t('ui.eventDescriptionLabel'),
	bitcoinAddressLabel: t('ui.bitcoinAddressLabel'),
	bitcoinAmountLabel: t('ui.bitcoinAmountLabel'),
	bitcoinLabelLabel: t('ui.bitcoinLabelLabel'),
	bitcoinMessageLabel: t('ui.bitcoinMessageLabel'),
	bitcoinAmountInvalid: t('ui.bitcoinAmountInvalid'),
	whatsappPhoneLabel: t('ui.whatsappPhoneLabel'),
	whatsappMessageLabel: t('ui.whatsappMessageLabel'),
	advancedHeading: t('ui.advancedHeading'),
	eyesHeading: t('ui.eyesHeading'),
	eyeSquareStyleLabel: t('ui.eyeSquareStyleLabel'),
	eyeDotStyleLabel: t('ui.eyeDotStyleLabel'),
	eyeSameAsBody: t('ui.eyeSameAsBody'),
	eyeSquareStyleSquare: t('ui.eyeSquareStyleSquare'),
	eyeSquareStyleDot: t('ui.eyeSquareStyleDot'),
	eyeSquareStyleExtraRounded: t('ui.eyeSquareStyleExtraRounded'),
	eyeDotStyleSquare: t('ui.eyeDotStyleSquare'),
	eyeDotStyleDot: t('ui.eyeDotStyleDot'),
	eyeColorOverrideLabel: t('ui.eyeColorOverrideLabel'),
	eyeSquareColorLabel: t('ui.eyeSquareColorLabel'),
	eyeDotColorLabel: t('ui.eyeDotColorLabel'),
	downloadJpeg: t('ui.downloadJpeg'),
	downloadPdf: t('ui.downloadPdf'),
	pdfLayoutLabel: t('ui.pdfLayoutLabel'),
	pdfLayoutA4: t('ui.pdfLayoutA4'),
	pdfLayoutFit: t('ui.pdfLayoutFit'),
	designHeading: t('ui.designHeading'),
	designSave: t('ui.designSave'),
	designLoad: t('ui.designLoad'),
	designExport: t('ui.designExport'),
	designImport: t('ui.designImport'),
	designSaved: t('ui.designSaved'),
	designLoaded: t('ui.designLoaded'),
	designNoneSaved: t('ui.designNoneSaved'),
	designImportError: t('ui.designImportError'),
	designLogoNote: t('ui.designLogoNote'),
};

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang} ogImage={`/og/${tool.category}.png`}>
	<script type="application/ld+json" set:html={jsonLd(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-heading-1 text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6">
			<QrCodeGenerator client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 mx-auto text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a
							href={`/${lang}/tools/${related.slugs[lang]}/`}
							class="text-sm text-primary hover:underline"
						>
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
