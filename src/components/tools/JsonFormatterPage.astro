---
import { jsonLd } from '@/lib/json-ld';
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import JsonFormatter from './JsonFormatter';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-json-formatter');

const tool = tools.find((item) => item.id === 'json-formatter')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	heading: t('heading'),
	themeNotice: t('ui.themeNotice'),
	errorWithLine: t('ui.errorWithLine'),
	errorNoLine: t('ui.errorNoLine'),
	goToErrorLine: t('ui.goToErrorLine'),
	exportHeading: t('ui.exportHeading'),
	exportXml: t('ui.exportXml'),
	exportYaml: t('ui.exportYaml'),
	exportCsv: t('ui.exportCsv'),
	exportInvalidJson: t('ui.exportInvalidJson'),
	copy: t('ui.copy'),
	copied: t('ui.copied'),
	download: t('ui.download'),
	validJsonBadge: t('ui.validJsonBadge'),
	invalidJsonBadge: t('ui.invalidJsonBadge'),
	compareHeading: t('ui.compareHeading'),
	compareToggle: t('ui.compareToggle'),
	compareInputLabel: t('ui.compareInputLabel'),
	compareInputPlaceholder: t('ui.compareInputPlaceholder'),
	compareButton: t('ui.compareButton'),
	compareInvalidLeft: t('ui.compareInvalidLeft'),
	compareInvalidRight: t('ui.compareInvalidRight'),
	compareIdentical: t('ui.compareIdentical'),
	compareDiffCount: t('ui.compareDiffCount'),
	compareAdded: t('ui.compareAdded'),
	compareRemoved: t('ui.compareRemoved'),
	compareChanged: t('ui.compareChanged'),
	warnUnsafeNumbers: t('ui.warnUnsafeNumbers'),
	warnDuplicateKeys: t('ui.warnDuplicateKeys'),
	warnCsvCollisions: t('ui.warnCsvCollisions'),
	copyFailed: t('ui.copyFailed'),
	copyExportAria: t('ui.copyExportAria'),
	downloadExportAria: t('ui.downloadExportAria'),
	adv: {
		heading: t('ui.adv.heading'),
		indentLabel: t('ui.adv.indentLabel'),
		indent2: t('ui.adv.indent2'),
		indent4: t('ui.adv.indent4'),
		indentTab: t('ui.adv.indentTab'),
		format: t('ui.adv.format'),
		minify: t('ui.adv.minify'),
		repair: t('ui.adv.repair'),
		share: t('ui.adv.share'),
		shareCopied: t('ui.adv.shareCopied'),
		shareFailed: t('ui.adv.shareFailed'),
		shareNote: t('ui.adv.shareNote'),
		formatInvalid: t('ui.adv.formatInvalid'),
		repairedPrefix: t('ui.adv.repairedPrefix'),
		repairedNone: t('ui.adv.repairedNone'),
		repairedGeneric: t('ui.adv.repairedGeneric'),
		repairFailed: t('ui.adv.repairFailed'),
		issueCodeFence: t('ui.adv.issueCodeFence'),
		issueComments: t('ui.adv.issueComments'),
		issueSingleQuotes: t('ui.adv.issueSingleQuotes'),
		issueTrailingCommas: t('ui.adv.issueTrailingCommas'),
		issueUnquotedKeys: t('ui.adv.issueUnquotedKeys'),
		issueConstants: t('ui.adv.issueConstants'),
		issueNdjson: t('ui.adv.issueNdjson'),
		issueUnbalanced: t('ui.adv.issueUnbalanced'),
		codeHeading: t('ui.adv.codeHeading'),
		codeGenerate: t('ui.adv.codeGenerate'),
		codeLanguage: t('ui.adv.codeLanguage'),
		rootName: t('ui.adv.rootName'),
		copy: t('ui.adv.copy'),
		copied: t('ui.adv.copied'),
		copyFailed: t('ui.adv.copyFailed'),
		needValidJson: t('ui.adv.needValidJson'),
		schemaHeading: t('ui.adv.schemaHeading'),
		schemaGenerate: t('ui.adv.schemaGenerate'),
		schemaOutputLabel: t('ui.adv.schemaOutputLabel'),
		validateHeading: t('ui.adv.validateHeading'),
		schemaInputLabel: t('ui.adv.schemaInputLabel'),
		schemaInputPlaceholder: t('ui.adv.schemaInputPlaceholder'),
		validateButton: t('ui.adv.validateButton'),
		validateOk: t('ui.adv.validateOk'),
		validateErrors: t('ui.adv.validateErrors'),
		schemaInvalid: t('ui.adv.schemaInvalid'),
		pathHeading: t('ui.adv.pathHeading'),
		pathLabel: t('ui.adv.pathLabel'),
		pathPlaceholder: t('ui.adv.pathPlaceholder'),
		pathRun: t('ui.adv.pathRun'),
		pathResults: t('ui.adv.pathResults'),
		pathNone: t('ui.adv.pathNone'),
		pathSyntax: t('ui.adv.pathSyntax'),
		pathHelp: t('ui.adv.pathHelp'),
		pathsLabel: t('ui.adv.pathsLabel'),
	},
};

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang} ogImage={`/og/${tool.category}.png`}>
	<script type="application/ld+json" set:html={jsonLd(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-heading-1 text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6">
			<JsonFormatter client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 mx-auto [overflow-wrap:anywhere] text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a
							href={`/${lang}/tools/${related.slugs[lang]}/`}
							class="text-sm text-primary hover:underline"
						>
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
