---
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import SvgOptimizer from './SvgOptimizer';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-svg-optimizer');

const tool = tools.find((item) => item.id === 'svg-optimizer')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	inputLabel: t('ui.inputLabel'),
	inputPlaceholder: t('ui.inputPlaceholder'),
	dropHint: t('ui.dropHint'),
	chooseFile: t('ui.chooseFile'),
	loadSample: t('ui.loadSample'),
	clear: t('ui.clear'),
	optionsHeading: t('ui.optionsHeading'),
	optMultipass: t('ui.optMultipass'),
	optPrecisionLabel: t('ui.optPrecisionLabel'),
	optRemoveDimensions: t('ui.optRemoveDimensions'),
	optPrettify: t('ui.optPrettify'),
	originalHeading: t('ui.originalHeading'),
	optimizedHeading: t('ui.optimizedHeading'),
	previewTab: t('ui.previewTab'),
	codeTab: t('ui.codeTab'),
	sizeLabel: t('ui.sizeLabel'),
	reduced: t('ui.reduced'),
	copy: t('ui.copy'),
	copied: t('ui.copied'),
	download: t('ui.download'),
	invalidSvgError: t('ui.invalidSvgError'),
	notSvgError: t('ui.notSvgError'),
	noInput: t('ui.noInput'),
	pluginsToggle: t('ui.pluginsToggle'),
	pluginRemoveDoctype: t('ui.pluginRemoveDoctype'),
	pluginRemoveXMLProcInst: t('ui.pluginRemoveXMLProcInst'),
	pluginRemoveComments: t('ui.pluginRemoveComments'),
	pluginRemoveDeprecatedAttrs: t('ui.pluginRemoveDeprecatedAttrs'),
	pluginRemoveMetadata: t('ui.pluginRemoveMetadata'),
	pluginRemoveEditorsNSData: t('ui.pluginRemoveEditorsNSData'),
	pluginCleanupAttrs: t('ui.pluginCleanupAttrs'),
	pluginMergeStyles: t('ui.pluginMergeStyles'),
	pluginInlineStyles: t('ui.pluginInlineStyles'),
	pluginMinifyStyles: t('ui.pluginMinifyStyles'),
	pluginCleanupIds: t('ui.pluginCleanupIds'),
	pluginRemoveUselessDefs: t('ui.pluginRemoveUselessDefs'),
	pluginCleanupNumericValues: t('ui.pluginCleanupNumericValues'),
	pluginConvertColors: t('ui.pluginConvertColors'),
	pluginRemoveUnknownsAndDefaults: t('ui.pluginRemoveUnknownsAndDefaults'),
	pluginRemoveNonInheritableGroupAttrs: t('ui.pluginRemoveNonInheritableGroupAttrs'),
	pluginRemoveUselessStrokeAndFill: t('ui.pluginRemoveUselessStrokeAndFill'),
	pluginCleanupEnableBackground: t('ui.pluginCleanupEnableBackground'),
	pluginRemoveHiddenElems: t('ui.pluginRemoveHiddenElems'),
	pluginRemoveEmptyText: t('ui.pluginRemoveEmptyText'),
	pluginConvertShapeToPath: t('ui.pluginConvertShapeToPath'),
	pluginConvertEllipseToCircle: t('ui.pluginConvertEllipseToCircle'),
	pluginMoveElemsAttrsToGroup: t('ui.pluginMoveElemsAttrsToGroup'),
	pluginMoveGroupAttrsToElems: t('ui.pluginMoveGroupAttrsToElems'),
	pluginCollapseGroups: t('ui.pluginCollapseGroups'),
	pluginConvertPathData: t('ui.pluginConvertPathData'),
	pluginConvertTransform: t('ui.pluginConvertTransform'),
	pluginRemoveEmptyAttrs: t('ui.pluginRemoveEmptyAttrs'),
	pluginRemoveEmptyContainers: t('ui.pluginRemoveEmptyContainers'),
	pluginMergePaths: t('ui.pluginMergePaths'),
	pluginRemoveUnusedNS: t('ui.pluginRemoveUnusedNS'),
	pluginSortAttrs: t('ui.pluginSortAttrs'),
	pluginSortDefsChildren: t('ui.pluginSortDefsChildren'),
	pluginRemoveDesc: t('ui.pluginRemoveDesc'),
	pluginRemoveViewBox: t('ui.pluginRemoveViewBox'),
};

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'MultimediaApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-3xl font-bold text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6 max-w-4xl">
			<SvgOptimizer client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a
							href={`/${lang}/tools/${related.slugs[lang]}/`}
							class="text-sm text-primary hover:underline"
						>
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
