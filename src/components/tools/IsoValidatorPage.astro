---
import { jsonLd } from '@/lib/json-ld';
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import IsoValidator from './IsoValidator';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-iso-validator');

const tool = tools.find((item) => item.id === 'iso-validator')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
// Internal links to tools people use right after validating identifiers.
const relatedIds = ['csv-json-converter', 'regex-tester', 'text-diff'];
const relatedTools = relatedIds.map((id) => tools.find((item) => item.id === id)).filter((item) => item !== undefined);

// All UI strings live under `ui.*` and go through i18n.
// i18next does not merge missing keys inside a returned object from the fallback language, so overlay the English
// strings first: a locale that has not translated a newly added message then shows English instead of nothing.
const tEn = getFixedT('en', 'tool-iso-validator');
const merge = (base: unknown, over: unknown): unknown => {
	if (base && over && typeof base === 'object' && typeof over === 'object' && !Array.isArray(base) && !Array.isArray(over)) {
		const out: Record<string, unknown> = { ...(base as Record<string, unknown>) };
		for (const [k, v] of Object.entries(over as Record<string, unknown>)) out[k] = merge(out[k], v);
		return out;
	}
	return over ?? base;
};
const messages = merge(tEn('ui', { returnObjects: true }), t('ui', { returnObjects: true })) as never;

const faqItems = [1, 2, 3, 4, 5, 6].map((n) => ({ question: t(`faq.q${n}`, { defaultValue: tEn(`faq.q${n}`) }), answer: t(`faq.a${n}`, { defaultValue: tEn(`faq.a${n}`) }) }));

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang} ogImage={`/og/${tool.category}.png`}>
	<script type="application/ld+json" set:html={jsonLd(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-heading-1 text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6">
			<IsoValidator client:load messages={messages} lang={lang} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 mx-auto flex max-w-3xl flex-col gap-4 [overflow-wrap:anywhere] text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
			<p>{t('article.p5', { defaultValue: tEn('article.p5') })}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a href={`/${lang}/tools/${related!.slugs[lang]}/`} class="text-sm text-primary hover:underline">
							{related!.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
