---
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import JwtDecoder from './JwtDecoder';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-jwt-decoder');

const tool = tools.find((item) => item.id === 'jwt-decoder')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	tokenLabel: t('ui.tokenLabel'),
	tokenPlaceholder: t('ui.tokenPlaceholder'),
	loadSample: t('ui.loadSample'),
	clear: t('ui.clear'),
	decodeErrorFormat: t('ui.decodeErrorFormat'),
	decodeErrorBase64: t('ui.decodeErrorBase64'),
	decodeErrorJson: t('ui.decodeErrorJson'),
	headerHeading: t('ui.headerHeading'),
	payloadHeading: t('ui.payloadHeading'),
	signatureHeading: t('ui.signatureHeading'),
	algorithmLabel: t('ui.algorithmLabel'),
	claimsHeading: t('ui.claimsHeading'),
	issuedAtLabel: t('ui.issuedAtLabel'),
	expiresAtLabel: t('ui.expiresAtLabel'),
	notBeforeLabel: t('ui.notBeforeLabel'),
	audienceLabel: t('ui.audienceLabel'),
	issuerLabel: t('ui.issuerLabel'),
	subjectLabel: t('ui.subjectLabel'),
	expiredBadge: t('ui.expiredBadge'),
	validBadge: t('ui.validBadge'),
	noStandardClaims: t('ui.noStandardClaims'),
	verifyHeading: t('ui.verifyHeading'),
	verifyAlgorithmUnsupported: t('ui.verifyAlgorithmUnsupported'),
	secretLabel: t('ui.secretLabel'),
	secretPlaceholder: t('ui.secretPlaceholder'),
	publicKeyLabel: t('ui.publicKeyLabel'),
	publicKeyPlaceholder: t('ui.publicKeyPlaceholder'),
	verifyButton: t('ui.verifyButton'),
	signatureValid: t('ui.signatureValid'),
	signatureInvalid: t('ui.signatureInvalid'),
	verifyEnterSecret: t('ui.verifyEnterSecret'),
	verifyEnterPublicKey: t('ui.verifyEnterPublicKey'),
	verifyInvalidPublicKey: t('ui.verifyInvalidPublicKey'),
	localVerifyNotice: t('ui.localVerifyNotice'),
	editHeading: t('ui.editHeading'),
	editHeaderLabel: t('ui.editHeaderLabel'),
	editPayloadLabel: t('ui.editPayloadLabel'),
	resignButton: t('ui.resignButton'),
	resignedTokenLabel: t('ui.resignedTokenLabel'),
	resignInvalidJson: t('ui.resignInvalidJson'),
	resignUnsupportedAlgorithm: t('ui.resignUnsupportedAlgorithm'),
	resignMissingSecret: t('ui.resignMissingSecret'),
	copy: t('ui.copy'),
	copied: t('ui.copied'),
};

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-3xl font-bold text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6 max-w-4xl">
			<JwtDecoder client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a
							href={`/${lang}/tools/${related.slugs[lang]}/`}
							class="text-sm text-primary hover:underline"
						>
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
