---
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import KubernetesYamlValidator from './KubernetesYamlValidator';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-kubernetes-yaml-validator');

const tool = tools.find((item) => item.id === 'kubernetes-yaml-validator')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	inputLabel: t('ui.inputLabel'),
	inputPlaceholder: t('ui.inputPlaceholder'),
	dropHint: t('ui.dropHint'),
	chooseFile: t('ui.chooseFile'),
	loadSample: t('ui.loadSample'),
	clear: t('ui.clear'),
	privacyNote: t('ui.privacyNote'),
	versionLabel: t('ui.versionLabel'),
	versionMaster: t('ui.versionMaster'),
	validating: t('ui.validating'),
	documentHeading: t('ui.documentHeading'),
	kindBadge: t('ui.kindBadge'),
	noIssues: t('ui.noIssues'),
	summaryLabel: t('ui.summaryLabel'),
	severityError: t('ui.severityError'),
	severityWarning: t('ui.severityWarning'),
	jumpToLine: t('ui.jumpToLine'),
	fixApiVersion: t('ui.fixApiVersion'),
	fixApiVersionCopied: t('ui.fixApiVersionCopied'),
	multiDocHint: t('ui.multiDocHint'),
};

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
	{ question: t('faq.q4'), answer: t('faq.a4') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang} ogImage={`/og/${tool.category}.png`}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-heading-1 text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6">
			<KubernetesYamlValidator client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 mx-auto text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a
							href={`/${lang}/tools/${related.slugs[lang]}/`}
							class="text-sm text-primary hover:underline"
						>
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
