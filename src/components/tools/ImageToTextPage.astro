---
import { jsonLd } from '@/lib/json-ld';
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import ImageToText, { type ImageToTextMessages } from './ImageToText';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import { OCR_LANGUAGES } from '@/lib/ocr-languages';
import { IMAGE_TO_TEXT_UI_KEYS } from '@/lib/ocr-ui-keys';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-image-to-text');

const tool = tools.find((item) => item.id === 'image-to-text')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Công cụ liên quan: xử lý tiếp văn bản sau OCR (so sánh, đếm từ, đổi kiểu chữ) + 1 công cụ ảnh gần nhất.
const relatedIds = ['text-diff', 'word-counter', 'text-case-converter', 'image-compress'];
const relatedTools = relatedIds.map((id) => tools.find((item) => item.id === id)!).filter(Boolean);
const textDiffTool = tools.find((item) => item.id === 'text-diff')!;
const textDiffHref = `/${lang}/tools/${textDiffTool.slugs[lang]}/`;

const messages = Object.fromEntries(IMAGE_TO_TEXT_UI_KEYS.map((key) => [key, t(`ui.${key}`)])) as unknown as ImageToTextMessages;
const languageNames = Object.fromEntries(OCR_LANGUAGES.map((code) => [code, t(`languages.${code}`)]));

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
	{ question: t('faq.q4'), answer: t('faq.a4') },
	{ question: t('faq.q5'), answer: t('faq.a5') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'UtilitiesApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang} ogImage={`/og/${tool.category}.png`}>
	<script type="application/ld+json" set:html={jsonLd(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-heading-1 text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6">
			<ImageToText client:load messages={messages} languageNames={languageNames} locale={lang} textDiffHref={textDiffHref} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('article.heading')}</h2>
		<div class="mx-auto mt-4 flex max-w-3xl flex-col gap-4 text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
			<p>{t('article.p5')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a href={`/${lang}/tools/${related.slugs[lang]}/`} class="text-sm text-primary hover:underline">
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
