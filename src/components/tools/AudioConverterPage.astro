---
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import AudioConverter from './AudioConverter';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-audio-converter');

const tool = tools.find((item) => item.id === 'audio-converter')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	dropLabel: t('ui.dropLabel'),
	chooseFile: t('ui.chooseFile'),
	previewLabel: t('ui.previewLabel'),
	outputFormatLabel: t('ui.outputFormatLabel'),
	formatMp3: t('ui.formatMp3'),
	formatWav: t('ui.formatWav'),
	bitrateLabel: t('ui.bitrateLabel'),
	convertButton: t('ui.convertButton'),
	decodingLabel: t('ui.decodingLabel'),
	encodingLabel: t('ui.encodingLabel'),
	resultLabel: t('ui.resultLabel'),
	download: t('ui.download'),
	originalLabel: t('ui.originalLabel'),
	convertedLabel: t('ui.convertedLabel'),
	sizeAndDuration: t('ui.sizeAndDuration'),
	clear: t('ui.clear'),
	decodeError: t('ui.decodeError'),
	encodeError: t('ui.encodeError'),
	channelDownmixWarning: t('ui.channelDownmixWarning'),
	resampleToggleLabel: t('ui.resampleToggleLabel'),
	sampleRateLabel: t('ui.sampleRateLabel'),
	normalizeToggleLabel: t('ui.normalizeToggleLabel'),
	fadeInLabel: t('ui.fadeInLabel'),
	fadeOutLabel: t('ui.fadeOutLabel'),
};

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'MultimediaApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-3xl font-bold text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6 max-w-4xl">
			<AudioConverter client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a href={`/${lang}/tools/${related.slugs[lang]}/`} class="text-sm text-primary hover:underline">
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
