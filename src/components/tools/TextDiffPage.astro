---
import { jsonLd } from '@/lib/json-ld';
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import TextDiffChecker from './TextDiffChecker';
import i18next from 'i18next';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-text-diff');

const tool = tools.find((item) => item.id === 'text-diff')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	originalLabel: t('ui.originalLabel'),
	changedLabel: t('ui.changedLabel'),
	modeWord: t('ui.modeWord'),
	modeLine: t('ui.modeLine'),
	modeChar: t('ui.modeChar'),
	noChanges: t('ui.noChanges'),
	placeholder: t('ui.placeholder'),
	ignoreWhitespace: t('ui.ignoreWhitespace'),
	ignoreCase: t('ui.ignoreCase'),
	ignoreEmptyLines: t('ui.ignoreEmptyLines'),
	normalizeLineEndings: t('ui.normalizeLineEndings'),
	normalizeUnicode: t('ui.normalizeUnicode'),
	computing: t('ui.computing'),
	statsAdded: t('ui.statsAdded'),
	statsRemoved: t('ui.statsRemoved'),
	statsModified: t('ui.statsModified'),
	clear: t('ui.clear'),
	swap: t('ui.swap'),
	uploadFile: t('ui.uploadFile'),
	prevChange: t('ui.prevChange'),
	nextChange: t('ui.nextChange'),
	changeCounter: t('ui.changeCounter'),
	fullscreen: t('ui.fullscreen'),
	exitFullscreen: t('ui.exitFullscreen'),
	mergeToolHeading: t('ui.mergeToolHeading'),
	mergeLeftHeading: t('ui.mergeLeftHeading'),
	mergeRightHeading: t('ui.mergeRightHeading'),
	acceptRightAria: t('ui.acceptRightAria'),
	acceptLeftAria: t('ui.acceptLeftAria'),
	copy: t('ui.copy'),
	copied: t('ui.copied'),
	save: t('ui.save'),
	copyShareLink: t('ui.copyShareLink'),
	formatButton: t('ui.formatButton'),
	formatError: t('ui.formatError'),
	clearedNotice: t('ui.clearedNotice'),
	undo: t('ui.undo'),
	replacedNotice: t('ui.replacedNotice'),
	clearAria: t('ui.clearAria'),
	swapAria: t('ui.swapAria'),
	uploadAria: t('ui.uploadAria'),
	copyMergedAria: t('ui.copyMergedAria'),
	saveMergedAria: t('ui.saveMergedAria'),
	formatDuplicateKeys: t('ui.formatDuplicateKeys'),
	formatLanguageLabel: t('ui.formatLanguageLabel'),
	formatAuto: t('ui.formatAuto'),
	formatIndentLabel: t('ui.formatIndentLabel'),
	formatIndent2: t('ui.formatIndent2'),
	formatIndent4: t('ui.formatIndent4'),
	formatIndentTab: t('ui.formatIndentTab'),
	formatWidthLabel: t('ui.formatWidthLabel'),
	formatSqlDialectLabel: t('ui.formatSqlDialectLabel'),
	formatBothAria: t('ui.formatBothAria'),
	formatEmptyBoth: t('ui.formatEmptyBoth'),
	formatOptions: t('ui.formatOptions'),
	formatOptionsHint: t('ui.formatOptionsHint'),
	dismissNotice: t('ui.dismissNotice'),
	compareButton: t('ui.compareButton'),
	compareAria: t('ui.compareAria'),
	compareEmpty: t('ui.compareEmpty'),
	compareFound: t('ui.compareFound'),
	compareIdentical: t('ui.compareIdentical'),
	resultsHeading: t('ui.resultsHeading'),
	formatBusy: t('ui.formatBusy'),
	formatDone: t('ui.formatDone'),
	formatDoneAuto: t('ui.formatDoneAuto'),
	formatNoChange: t('ui.formatNoChange'),
	formatEmpty: t('ui.formatEmpty'),
	formatErrorAt: t('ui.formatErrorAt'),
	formatErrorLine: t('ui.formatErrorLine'),
	formatErrorNoPos: t('ui.formatErrorNoPos'),
	formatAmbiguous: t('ui.formatAmbiguous'),
	formatUnknown: t('ui.formatUnknown'),
	formatTooLarge: t('ui.formatTooLarge'),
	formatLargeWarning: t('ui.formatLargeWarning'),
	formatTimeout: t('ui.formatTimeout'),
	formatFailed: t('ui.formatFailed'),
	formatStale: t('ui.formatStale'),
	formatMismatch: t('ui.formatMismatch'),
	largeInputWarning: t('ui.largeInputWarning'),
	workerError: t('ui.workerError'),
	trailingNewlineNote: t('ui.trailingNewlineNote'),
	lineEndingsNote: t('ui.lineEndingsNote'),
	noLineChangesButNotes: t('ui.noLineChangesButNotes'),
	sharedLoadedNotice: t('ui.sharedLoadedNotice'),
	restoreDraft: t('ui.restoreDraft'),
	clipboardError: t('ui.clipboardError'),
	fileReadError: t('ui.fileReadError'),
	x: t('ui.x', { returnObjects: true }) as never,
	files: t('ui.files', { returnObjects: true }) as never,
};

// The Format article paragraph / FAQ entry are rendered only in locales that already have them,
// so a not-yet-translated locale never shows an English paragraph in the middle of its page.
const hasOwn = (key: string) => i18next.getResource(lang, 'tool-text-diff', key) !== undefined;

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
	...(hasOwn('faq.q4') ? [{ question: t('faq.q4'), answer: t('faq.a4') }] : []),
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'UtilitiesApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang} ogImage={`/og/${tool.category}.png`}>
	<script type="application/ld+json" set:html={jsonLd(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-heading-1 text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6">
			<TextDiffChecker client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 mx-auto [overflow-wrap:anywhere] text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
			{hasOwn('article.p5') && <p>{t('article.p5')}</p>}
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a
							href={`/${lang}/tools/${related.slugs[lang]}/`}
							class="text-sm text-primary hover:underline"
						>
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
