---
import { jsonLd } from '@/lib/json-ld';
import Layout from '../../layouts/Layout.astro';
import FaqSection from '@/components/layout/FaqSection.astro';
import JsonExcelConverter from './JsonExcelConverter';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-json-excel-converter');

const tool = tools.find((item) => item.id === 'json-excel-converter')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	sheetNameLabel: t('ui.sheetNameLabel'),
	sheetNamePlaceholder: t('ui.sheetNamePlaceholder'),
	fileNameLabel: t('ui.fileNameLabel'),
	fileNamePlaceholder: t('ui.fileNamePlaceholder'),
	flattenLabel: t('ui.flattenLabel'),
	flattenHint: t('ui.flattenHint'),
	inputLabel: t('ui.inputLabel'),
	inputPlaceholder: t('ui.inputPlaceholder'),
	dropLabel: t('ui.dropLabel'),
	chooseFile: t('ui.chooseFile'),
	loadSample: t('ui.loadSample'),
	clear: t('ui.clear'),
	jsonParseError: t('ui.jsonParseError'),
	jsonRootError: t('ui.jsonRootError'),
	previewHeading: t('ui.previewHeading'),
	previewInfo: t('ui.previewInfo'),
	sheetsInfo: t('ui.sheetsInfo'),
	moreRows: t('ui.moreRows'),
	download: t('ui.download'),
	generating: t('ui.generating'),
	downloadError: t('ui.downloadError'),
	unwrapLabel: t('ui.unwrapLabel'),
	unwrappedInfo: t('ui.unwrappedInfo'),
	emptyState: t('ui.emptyState'),
	emptyKey: t('ui.emptyKey'),
	previewCaption: t('ui.previewCaption'),
	fileReadError: t('ui.fileReadError'),
	warnTruncatedCells: t('ui.warnTruncatedCells'),
	warnRowLimit: t('ui.warnRowLimit'),
	warnColLimit: t('ui.warnColLimit'),
	warnUnsafeIntegers: t('ui.warnUnsafeIntegers'),
	warnRenamedSheets: t('ui.warnRenamedSheets'),
	advancedHeading: t('ui.advancedHeading'),
	arrayModeLabel: t('ui.arrayModeLabel'),
	arrayModeJson: t('ui.arrayModeJson'),
	arrayModeDetail: t('ui.arrayModeDetail'),
	arrayModeJoin: t('ui.arrayModeJoin'),
	arrayModeDetailInfo: t('ui.arrayModeDetailInfo'),
	joinSeparatorLabel: t('ui.joinSeparatorLabel'),
	isoDatesLabel: t('ui.isoDatesLabel'),
	epochLabel: t('ui.epochLabel'),
	epochOff: t('ui.epochOff'),
	epochSeconds: t('ui.epochSeconds'),
	epochMilliseconds: t('ui.epochMilliseconds'),
	datesHint: t('ui.datesHint'),
	freezeLabel: t('ui.freezeLabel'),
	autoFilterLabel: t('ui.autoFilterLabel'),
	tableStyleLabel: t('ui.tableStyleLabel'),
	columnsHeading: t('ui.columnsHeading'),
	columnInclude: t('ui.columnInclude'),
	columnRename: t('ui.columnRename'),
	columnMoveUp: t('ui.columnMoveUp'),
	columnMoveDown: t('ui.columnMoveDown'),
	columnsReset: t('ui.columnsReset'),
	downloadCsv: t('ui.downloadCsv'),
};

const faqItems = [
	{ question: t('faq.q1'), answer: t('faq.a1') },
	{ question: t('faq.q2'), answer: t('faq.a2') },
	{ question: t('faq.q3'), answer: t('faq.a3') },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang} ogImage={`/og/${tool.category}.png`}>
	<script type="application/ld+json" set:html={jsonLd(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-heading-1 text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6">
			<JsonExcelConverter client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 mx-auto text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<FaqSection heading={t('faq.heading')} items={faqItems} />
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-heading-2 text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a href={`/${lang}/tools/${related.slugs[lang]}/`} class="text-sm text-primary hover:underline">
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
