---
import Layout from '../../layouts/Layout.astro';
import WordCounter from './WordCounter';
import { getFixedT } from '@/i18n/i18next';
import { tools } from '@/data/tools';
import type { Locale } from '@/i18n/config';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = getFixedT(lang, 'tool-word-counter');

const tool = tools.find((item) => item.id === 'word-counter')!;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedTools = tools.filter((item) => item.category === tool.category && item.id !== tool.id);

const messages = {
	placeholder: t('ui.placeholder'),
	charsLabel: t('ui.charsLabel'),
	charsNoSpacesLabel: t('ui.charsNoSpacesLabel'),
	wordsLabel: t('ui.wordsLabel'),
	sentencesLabel: t('ui.sentencesLabel'),
	paragraphsLabel: t('ui.paragraphsLabel'),
	readingTimeLabel: t('ui.readingTimeLabel'),
	readingTimeValue: t('ui.readingTimeValue'),
	speakingTimeLabel: t('ui.speakingTimeLabel'),
	speakingTimeValue: t('ui.speakingTimeValue'),
	clear: t('ui.clear'),
	copy: t('ui.copy'),
	copied: t('ui.copied'),
	download: t('ui.download'),
	charLimitLabel: t('ui.charLimitLabel'),
	charLimitNone: t('ui.charLimitNone'),
	charLimitTwitter: t('ui.charLimitTwitter'),
	charLimitMetaDescription: t('ui.charLimitMetaDescription'),
	charLimitInstagram: t('ui.charLimitInstagram'),
	charLimitYoutubeTitle: t('ui.charLimitYoutubeTitle'),
	charLimitSms: t('ui.charLimitSms'),
	charLimitRemaining: t('ui.charLimitRemaining'),
	charLimitOver: t('ui.charLimitOver'),
	readabilityHeading: t('ui.readabilityHeading'),
	readabilityScoreLabel: t('ui.readabilityScoreLabel'),
	readabilityNotEnoughText: t('ui.readabilityNotEnoughText'),
	readabilityVeryEasy: t('ui.readabilityVeryEasy'),
	readabilityEasy: t('ui.readabilityEasy'),
	readabilityFairlyEasy: t('ui.readabilityFairlyEasy'),
	readabilityStandard: t('ui.readabilityStandard'),
	readabilityFairlyDifficult: t('ui.readabilityFairlyDifficult'),
	readabilityDifficult: t('ui.readabilityDifficult'),
	readabilityVeryConfusing: t('ui.readabilityVeryConfusing'),
	keywordDensityHeading: t('ui.keywordDensityHeading'),
	keywordDensityWordColumn: t('ui.keywordDensityWordColumn'),
	keywordDensityCountColumn: t('ui.keywordDensityCountColumn'),
	keywordDensityPercentColumn: t('ui.keywordDensityPercentColumn'),
};

const schema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: t('heading'),
	description: t('meta.description'),
	url: canonicalUrl,
	applicationCategory: 'UtilitiesApplication',
	operatingSystem: 'Any',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
};
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang}>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	<section class="px-4 py-10">
		<h1 class="text-3xl font-bold text-foreground">{t('heading')}</h1>
		<p class="mt-2 text-muted-foreground">{t('tagline')}</p>
		<div class="mt-6 max-w-3xl">
			<WordCounter client:load messages={messages} />
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('article.heading')}</h2>
		<div class="mt-4 flex max-w-3xl flex-col gap-4 text-muted-foreground">
			<p>{t('article.p1')}</p>
			<p>{t('article.p2')}</p>
			<p>{t('article.p3')}</p>
			<p>{t('article.p4')}</p>
		</div>
	</section>
	<section class="border-t border-border px-4 py-10">
		<h2 class="text-xl font-semibold text-foreground">{t('related')}</h2>
		<ul class="mt-4 flex flex-col gap-1">
			{
				relatedTools.map((related) => (
					<li>
						<a
							href={`/${lang}/tools/${related.slugs[lang]}/`}
							class="text-sm text-primary hover:underline"
						>
							{related.names[lang]}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
